    { "name": "DST end night holds 7 h", "quiet": "berlin", "from": "2026-10-24T21:00:00Z", "to": "2026-10-25T06:00:00Z", "expected_ms": 7200000 },
    { "name": "DST start night holds 5 h", "quiet": "berlin", "from": "2027-03-27T22:00:00Z", "to": "2027-03-28T05:00:00Z", "expected_ms": 7200000 },
    { "name": "two nights", "quiet": "berlin", "from": "2026-10-18T18:00:00Z", "to": "2026-10-21T12:00:00Z", "expected_ms": 172800000 },
    { "name": "reversed span", "quiet": "berlin", "from": "2026-10-18T12:00:00Z", "to": "2026-10-18T11:00:00Z", "expected_ms": 0 },
