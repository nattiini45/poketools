    { "name": "zero ms inside a window returns the start unchanged", "quiet": "berlin", "from": "2026-10-18T01:00:00Z", "ms": 0, "expected": "2026-10-18T01:00:00Z" },
    { "name": "slow 12 h from 20:00", "quiet": "berlin", "from": "2026-10-18T18:00:00Z", "ms": 43200000, "expected": "2026-10-19T12:00:00Z" },
