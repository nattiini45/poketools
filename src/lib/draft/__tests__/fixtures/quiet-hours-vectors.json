    { "name": "DST start night (5 h held)", "quiet": "berlin", "from": "2027-03-27T22:00:00Z", "ms": 7200000, "expected": "2027-03-28T05:00:00Z" },
    { "name": "resume inside a window", "quiet": "berlin", "from": "2026-10-18T02:00:00Z", "ms": 900000, "expected": "2026-10-18T04:15:00Z" },
