    { "name": "UTC zone, 1-2 window", "quiet": "utc1to2", "from": "2026-10-18T00:30:00Z", "ms": 3600000, "expected": "2026-10-18T02:30:00Z" },
    { "name": "no quiet hours = wall addition", "quiet": null, "from": "2026-10-17T21:55:00Z", "ms": 1200000, "expected": "2026-10-17T22:15:00Z" }
