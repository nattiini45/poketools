        "queue": ["5 N", "6 K", "6.5 N(m)", "7 B", "8 S", "9 S", "10 B", "11 K", "12 N"],
        "active": { "key": "5", "player": "N", "kind": "normal", "status": "active", "deadline_at": 630 },
