        "mode": "live", "kind": "initial", "roster_size": 3,
        "seats": [{ "player": "S", "seat": 1 }, { "player": "B", "seat": 2 }, { "player": "K", "seat": 3 }, { "player": "N", "seat": 4 }]
      },
      "steps": [
