{
  "$comment": "Responsive draft-room fixture baselines, reviewed rather than frozen since F2.",
  "version": 1,
  "now": "2026-10-15T12:00:00.000Z",
  "viewports": {
    "phone": {
      "width": 390,
      "height": 844
    },
    "tablet": {
      "width": 768,
      "height": 1024
    },
    "laptop": {
      "width": 1366,
      "height": 900
    },
    "monitor": {
      "width": 1920,
      "height": 1080
    }
  },
  "themes": [
    "light",
    "dark"
  ],
  "defaults": {
    "settleMs": 400
  },
  "targets": [
    {
      "id": "draft-room",
      "waitFor": "body:not(:has([data-armed=\"false\"]))",
      "url": "/draft-preview?scenario={scenario}&world={world}&lang=en&now={now}",
      "clock": true,
      "matrix": {
        "scenario": [
          "live-my-turn",
          "live-waiting",
          "live-up-next",
          "live-paused",
          "live-makeup",
          "live-ext-used",
          "live-reasons",
          "live-filters",
          "live-confirm",
          "live-wall",
          "live-roster",
          "live-filters-more",
          "live-index-loading",
          "live-index-failed",
          "slow-my-turn",
          "slow-penalty",
          "redraft-submission",
          "redraft-locked",
          "redraft-reveal",
          "redraft-picking",
          "complete",
          "spectator",
          "signed-out",
          "admin-room",
          "admin-room-sheet",
          "admin-room-refused",
          "tokens-before",
          "tokens-open",
          "tokens-comeback",
          "many-drafted"
        ],
        "world": [
          "evoliga",
          "none"
        ]
      },
      "viewports": [
        "phone",
        "tablet",
        "laptop",
        "monitor"
      ],
      "roots": [
        "[data-draft-room]"
      ]
    },
    {
      "id": "draft-room-sakura",
      "waitFor": "body:not(:has([data-armed=\"false\"]))",
      "url": "/draft-preview?scenario={scenario}&world=sakura&lang=en&now={now}",
      "clock": true,
      "matrix": {
        "scenario": [
          "live-my-turn",
          "live-filters",
          "live-confirm",
          "redraft-reveal",
          "tokens-open",
          "admin-room-sheet"
        ]
      },
      "viewports": [
        "phone",
        "tablet",
        "laptop",
        "monitor"
      ],
      "roots": [
        "[data-draft-room]"
      ]
    },
    {
      "id": "draft-room-de",
      "url": "/draft-preview?scenario={scenario}&lang=de&now={now}",
      "clock": true,
      "matrix": {
        "scenario": [
          "live-my-turn",
          "live-filters",
          "redraft-submission",
          "tokens-open",
          "admin-room-sheet"
        ],
        "lang": [
          "de"
        ]
      },
      "viewports": [
        "phone",
        "tablet",
        "laptop",
        "monitor"
      ],
      "roots": [
        "[data-draft-room]"
      ]
    }
  ],
  "roles": {
    "admin": {
      "email": "local-admin@poketools.test",
      "password": "poketools-local-admin"
    }
  }
}
