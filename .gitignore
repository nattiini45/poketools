# overlay mirror outputs: scripts/mirror-private-overlay.mjs copies the private pack's overlay/
# into private roots under src/ (generated; edit the overlay, never the copy). Each root carries
# a self-ignoring .gitignore the mirror writes, so no public file names a private root.
# .overlay-manifest.json records what the mirror wrote, so stale outputs can be removed.
/.overlay-manifest.json
/.overlay-manifest.json.tmp

# retired agent and tooling artifacts; kept out of version control
/.trae/
/docs/archive/
/tools/persist_log.py
/scripts/_debug_replays.mjs

# world-asset pipeline working directories (scripts/world-assets/) — outputs live in Supabase Storage
scripts/world-assets/.cache/
scripts/world-assets/out/
# local mirror of the world-assets bucket (bake-manifest.mjs --mirror). The
# binaries stay local (published artefacts live in Supabase Storage). The world
# manifests (manifest.v3.json, the shipped one; manifest.json, the published v2
# descriptor) list a league's figure pool, so they are untracked: a checkout
# does not include them. A maintainer keeps them in the private companion
# overlay, which tracks both paths; if a pull removed them, restore them with
#   git --git-dir=<overlay> checkout -- public/models/world/manifest.json public/models/world/manifest.v3.json
# Without them the manifest tests skip, and the route world renders at the
# viewer's tier with sprite billboards instead of 3D figures and no props (the
# loader falls back to an empty manifest). Only the attribution is tracked.
public/models/world/*
!public/models/world/ATTRIBUTION.md
# the manifest lists env/ATTRIBUTION.md as a shipped environment asset,
# so it must be in the repo too — un-ignore the dir, then re-include just that file
!public/models/world/env/
public/models/world/env/*
!public/models/world/env/ATTRIBUTION.md

# avatar sprite source layers (scripts/deploy-avatar-sprites.mjs input; the deployed copies live in public/avatar/)
/avatars/

# third-party game assets that are not distributed with this repository (see NOTICE.md).
# A fresh checkout gets generated placeholder avatar layers (scripts/generate-placeholder-avatars.mjs,
# run by predev/prebuild); maintainers' builds fetch the real files (scripts/fetch-private-assets.mjs).
/public/avatar/
/public/models/draft-room/
# broadcast sprite renders: the deployment re-hosts them in its `sprites` bucket; the local mirror
# (scripts/sprites/mirror-broadcast.mjs output) and its download cache are never committed
/public/sprites/
scripts/sprites/.cache/

# EvoLiga Point Buy: the league's workbooks are supplied privately by the league organiser
# and never committed (the import scripts take them via --file)
EvoLiga Point Buy.zip
EvoLiga Point Buy/

