{
  "name": "poketools",
  "version": "0.1.0",
  "description": "Competitive Pokemon league and tournament management platform",
  "license": "MIT",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-placeholder-avatars.mjs --quiet",
    "dev": "next dev",
    "prebuild": "node scripts/fetch-private-assets.mjs && node scripts/generate-placeholder-avatars.mjs --quiet",
    "build": "next build",
    "assets:placeholders": "node scripts/generate-placeholder-avatars.mjs",
    "assets:fetch": "node scripts/fetch-private-assets.mjs",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:changed": "vitest related --changed",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:ci": "node scripts/verify-ci.mjs",
    "audit:seasons": "npx tsx --tsconfig scripts/tsconfig.audit.json scripts/run-season-audit.ts",
    "capture": "node scripts/capture.mjs",
    "capture:route": "node scripts/capture-route.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/openai": "^3.0.48",
    "@anthropic-ai/sdk": "^0.98.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@pkmn/client": "^0.7.2",
    "@pkmn/data": "^0.10.7",
    "@pkmn/dex": "^0.10.7",
    "@pkmn/img": "^0.3.3",
    "@pkmn/protocol": "^0.7.2",
    "@pkmn/sets": "^5.2.0",
    "@pkmn/smogon": "^0.5.29",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@react-three/rapier": "^2.2.0",
    "@smogon/calc": "^0.11.0",
    "@supabase/supabase-js": "^2.99.2",
    "@types/three": "^0.185.1",
    "@vercel/analytics": "^2.0.1",
    "ai": "^6.0.141",
    "braintrust": "^3.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.31.0",
    "motion": "^12.38.0",
    "n8ao": "^2.0.1",
    "next": "^16.3.0-preview.9",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "postprocessing": "^6.39.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "replicate": "^1.4.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.0",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@next/eslint-plugin-next": "^16.3.0-preview.9",
    "@types/node": "^25",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "canvas": "^3.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "meshoptimizer": "1.2.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "supabase": "^2.78.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "esbuild": "0.28.1",
    "vite": "^8.0.16",
    "postcss": "$postcss",
    "sharp": "$sharp",
    "minimatch": "^10.2.5",
    "brace-expansion": "5.0.12",
    "postcss-selector-parser": "^7.1.6"
  }
}
