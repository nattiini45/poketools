# Public site URL (optional) — the deployment's public origin, used as the
# absolute base for canonical and Open Graph URLs (src/app/layout.tsx) and for
# team share links. Canonical/OG URLs fall back to NEXTAUTH_URL, then to
# https://$VERCEL_PROJECT_PRODUCTION_URL (set by Vercel), then http://localhost:3000
# (src/lib/site-url.ts); team share links use the request origin, then this value.
# Set it in production, e.g. https://your-domain.example
# Production needs an https origin: a non-https value (other than localhost) is ignored.
# NEXT_PUBLIC_SITE_URL=

# Supabase (required) — your project URL, e.g. https://<project-ref>.supabase.co
# or http://127.0.0.1:54321 for a local stack (`npx supabase start`).
NEXT_PUBLIC_SUPABASE_URL=
# Required. Public anon/publishable key. Used by: (1) Cast Studio Supabase Realtime
# broadcasts (browser), (2) server-side Supabase Auth (GoTrue) calls for
# email/password login — src/lib/supabase/auth-client.ts.
# Publishable key format: sb_publishable_...
# All table writes still go through API routes using the service role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# EvoLiga Route World — public Supabase Storage bucket that hosts the plaza's
# Pokémon GLBs, KTX2 texture sets, façade kit and HDRIs plus manifest.json
# (docs/adr/0002). Populated by `node scripts/world-assets/upload-supabase.mjs`
# (needs SUPABASE_SERVICE_ROLE_KEY locally). Leave blank to fall back to the
# local mirror under public/models/world (not in the repository; build it with
# the scripts/world-assets/ pipeline). Without either, the 3D route world
# cannot load its models and stays on its Lite (non-3D) view.
# Example: https://<project-ref>.supabase.co/storage/v1/object/public/world-assets
NEXT_PUBLIC_WORLD_ASSETS_URL=

# Broadcast sprite renders (docs/pkmn.md, "Sprite styles") — public Supabase Storage bucket `sprites`
# that re-hosts the high-resolution renders (scripts/sprites/mirror-broadcast.mjs, then
# scripts/sprites/upload-supabase.mjs; both maintainer-run). Leave blank and the broadcast style
# falls back to the HOME renders (the repository ships no art). Only dev servers started with
# --require ./.claude/local-assets.cjs (the .claude/launch.json configs) and the capture harness
# use the local mirror /sprites instead; a plain `npm run dev` does NOT preload it, so a bucket URL
# here reaches that dev server and spends the quota: keep it blank in .env.local.
# A set value must be an absolute http(s) URL or a root-relative path; anything else fails the build.
# Example: https://<project-ref>.supabase.co/storage/v1/object/public/sprites
NEXT_PUBLIC_SPRITES_URL=

# Auth (Discord OAuth + Supabase email/password — see docs/auth-email-password.md
# for the required Supabase dashboard configuration: email provider, confirm
# email ON, email templates pointing at /auth/confirm and /auth/reset-password,
# and custom SMTP for production)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Superadmin (Discord user ID of the instance operator — auto-promoted to admin on every request)
SUPERADMIN_DISCORD_ID=
# Optional: superadmin match for email/password sessions (case-insensitive)
SUPERADMIN_EMAIL=

# AI — Anthropic API (match analysis, scouting reports, agent chat, Admin Assistant)
# The deprecated name CLAUDE_API_KEY is still read when ANTHROPIC_API_KEY is unset.
ANTHROPIC_API_KEY=
# Optional: default per-player daily limit for AI endpoints (default 10).
# AI_DAILY_LIMIT=10

# AI — NanoGPT (avatar image generation only)
NANOGPT_API_KEY=

# Bootstrap (one-time setup — required for /api/bootstrap and /api/seed-rulesets)
BOOTSTRAP_SECRET=
# Optional: set true only for first-time setup, before any admin exists, so
# /api/seed-rulesets accepts BOOTSTRAP_SECRET. Turn it off afterwards.
# BOOTSTRAP_MODE_ENABLED=false

# Required. Cron secret — protects /api/cron/* endpoints. Vercel Cron sends this as a Bearer token.
CRON_SECRET=

# AI — Replicate (photo-to-trainer avatar transform)
REPLICATE_API_TOKEN=
# Optional backward compatibility (deprecated):
# REPLICATE_API_TOKE=

# Azure Content Safety (image moderation)
AZURE_ENDPOINT_URL=
AZURE_ENDPOINT_KEY=
# Set to false only for local/dev fallback. Defaults to true in production.
AVATAR_MODERATION_REQUIRED=true
# Optional: comma-separated output host allowlist for Replicate downloads.
# REPLICATE_OUTPUT_HOST_ALLOWLIST=replicate.delivery,*.replicate.delivery

# Optional: Claude settings shared by every text AI surface (match analysis, scouting, the team
# coaches, the broadcast recap and Kale). ANTHROPIC_API_KEY (above) is the key they use; the
# deprecated CLAUDE_API_KEY still works when only that is set.
# CLAUDE_MODEL=claude-sonnet-5-5          # Model every surface asks first (default shown)
# CLAUDE_FALLBACK_MODEL=claude-haiku-5-5  # Asked once when the first model fails transiently (default shown)
# CLAUDE_API_EFFORT=medium                # 'low' | 'medium' | 'high' | 'xhigh' | 'max' (default medium).
#                                         # Sent only to models that support it; an invalid value is
#                                         # ignored with a warning.

# Kale Cabbage 2.0 — tournament report generation (uses the Claude settings above)
# KALE_PIPELINE_MODE=decomposed          # 'decomposed' (parallel tasks) | 'single' (one big prompt)
# KALE_TIMEOUT_MS=300000                  # Timeout of the first model in ms (default 300s)
# KALE_FALLBACK_TIMEOUT_MS=150000         # Timeout of the fallback model in ms (default 150s)
# KALE_MAX_TOKENS=4096                    # Default output cap. Every pipeline task sets its own cap
#                                         # (AI_MAX_TOKENS.kaleTask), so this only applies to a call
#                                         # without one (currently none).

# Optional: Braintrust AI observability
# BRAINTRUST_API_KEY=

# Social Integration — credential encryption (32-byte key as hex, base64, or utf8)
SOCIAL_INTEGRATION_ENCRYPTION_KEY=

# Optional: Auto-set by Vercel in production
# VERCEL_URL=
# Set by Vercel on every deployment (build and runtime); never set it yourself.
# It picks the rate-limiter store when RATE_LIMIT_STORE is unset (see below).
# VERCEL=1

# Optional: request rate-limiter store (src/lib/utils/rate-limit.ts,
# docs/security-patterns.md A04). 'postgres' = the shared rate_limit_hit table
# (one RPC per limited request, counts across every serverless instance);
# 'memory' = per process, no database call. Unset = 'postgres' on a Vercel
# deployment (VERCEL=1), 'memory' everywhere else (next dev, a local
# `next start`, the capture harness), so local runs and automation never spend
# the hosted Supabase quota. Set 'postgres' only to exercise the durable
# limiter against a LOCAL Supabase stack. Any other value stops the server at
# boot (src/instrumentation.ts).
# RATE_LIMIT_STORE=

# Feature flags
# Soft-deprecated Kale Cabbage AI tournament reporter (recaps & forecasts). Set true only for legacy report testing.
NEXT_PUBLIC_ENABLE_KALE_CABBAGE=false

# Route the SCOUTING card (opponent_scout) through the agent endpoint
# (/api/ai/agent/analyze-match). The agent persists the SAME structured
# MatchPrepAnalysisContent the card renders (deterministic opponent-scouting
# context injected + optional tool enrichment), reusing the per-(match, player)
# cache — so the cards are unchanged. When false, the card uses the legacy
# /api/ai/match-prep-analysis SSE route (the rollback path).
NEXT_PUBLIC_AGENT_MATCH_ANALYSIS=false

# Route the POST-MATCH analysis card through the agent endpoint
# (/api/ai/agent/analyze-match, post_match). The agent persists the SAME
# structured analysis the cards render (deterministic match context injected +
# optional tool enrichment), so the cards + per-match cache are unchanged. When
# false, the card uses the legacy /api/ai/match-analysis route (the rollback).
NEXT_PUBLIC_AGENT_POST_MATCH=false

# Admin Assistant (planned, optional; docs/poketools-spec.md section 18). Everything below is OFF by
# default: with nothing set the assistant is unreachable and the player agent above is unaffected.
# Every ADMIN_AGENT_* value is parsed with zod (src/lib/ai/admin-agent/env.ts): unset or blank means
# the default shown, the string "false" is off, and an invalid value switches the assistant off. If
# ADMIN_AGENT_ENABLED is on and a value is invalid, the server stops at boot and the error names the
# key (never the value). With the assistant off, nothing here can stop a boot.
# Shows or hides the admin nav item and the assistant UI only. The server switch below is the real gate.
NEXT_PUBLIC_ENABLE_ADMIN_ASSISTANT=false
# Server kill switch: every assistant route answers 404 while it is off.
# ADMIN_AGENT_ENABLED=false
# Lets the approve route run Go-live (G tier) proposals. Switch it on only after the Go-live
# classification gate is at 100% recall (spec 18.15).
# ADMIN_AGENT_GOLIVE=false
# Audience: site (site admins) or any (also league and tournament admins, scoped tools).
# ADMIN_AGENT_ROLES=site
# Comma-separated player UUIDs that may use the assistant; empty = everyone in the audience.
# ADMIN_AGENT_ALLOWED_PLAYER_IDS=
# Delivery-phase cap 0-5: the assistant exposes only operations of a phase at or below it. Invalid = 0.
# ADMIN_AGENT_MAX_PHASE=0
# Evaluation opt-ins (spec 18.15), unset in normal operation: run the loop or an evaluation against
# a non-local database outside a production build; local-database test suites (never honoured when CI=true).
# ADMIN_AGENT_ALLOW_HOSTED=
# ADMIN_AGENT_LIVE_DB=
# Models (Anthropic only, one per conversation) and effort (low | medium | high): write-capable
# conversations, read-only conversations, titles and language hints.
# ADMIN_AGENT_MODEL_WRITE=claude-opus-5-5
# ADMIN_AGENT_EFFORT_WRITE=medium
# ADMIN_AGENT_MODEL_READ=claude-sonnet-5-5
# ADMIN_AGENT_EFFORT_READ=medium
# ADMIN_AGENT_MODEL_SMALL=claude-haiku-5-5
# ADMIN_AGENT_EFFORT_SMALL=low
# Spending caps in US dollars (decimals allowed). Per conversation (the warning level defaults to
# 60% of the hard stop and must stay below it), per admin per day and month, all admins per day.
# ADMIN_AGENT_BUDGET_CONVERSATION_USD=5
# ADMIN_AGENT_BUDGET_CONVERSATION_WARN_USD=
# ADMIN_AGENT_BUDGET_ADMIN_DAY_USD=20
# ADMIN_AGENT_BUDGET_ADMIN_MONTH_USD=120
# ADMIN_AGENT_BUDGET_GLOBAL_DAY_USD=80
# Rate limits and per-turn limits: messages and executed writes per admin per hour, message length,
# model steps, tool calls and stagings per turn, the turn's wall-clock deadline (seconds; the chat
# route allows 300), and the share of the model window at which a new turn is refused.
# ADMIN_AGENT_TURNS_PER_HOUR=40
# ADMIN_AGENT_WRITES_PER_HOUR=60
# ADMIN_AGENT_MAX_TEXT_CHARS=8000
# ADMIN_AGENT_MAX_STEPS_PER_TURN=12
# ADMIN_AGENT_MAX_TOOL_CALLS_PER_TURN=30
# ADMIN_AGENT_MAX_STAGINGS_PER_TURN=4
# ADMIN_AGENT_TURN_DEADLINE_SECONDS=240
# ADMIN_AGENT_CONTEXT_REFUSE_PERCENT=80
# Per Build: steps and entity-creating steps.
# ADMIN_AGENT_MAX_BUILD_STEPS=40
# ADMIN_AGENT_MAX_BUILD_CREATES=10
# Blast radius per conversation, counted when a proposal is claimed: league, tournament, ruleset and
# format creates, Go-live executions, and targets moved by ruleset pin moves and publishes.
# ADMIN_AGENT_CAP_LEAGUE_CREATES=3
# ADMIN_AGENT_CAP_TOURNAMENT_CREATES=3
# ADMIN_AGENT_CAP_RULESET_CREATES=5
# ADMIN_AGENT_CAP_FORMAT_CREATES=8
# ADMIN_AGENT_CAP_GOLIVE_EXECUTIONS=6
# ADMIN_AGENT_CAP_PIN_TARGETS=50
# How long a confirmation card stays valid, in minutes (5-240).
# ADMIN_AGENT_PROPOSAL_TTL_BUILD_MINUTES=60
# ADMIN_AGENT_PROPOSAL_TTL_GOLIVE_MINUTES=15

# PWA (mobile install + offline shell)
# Set to true in environments where you want service worker registration.
NEXT_PUBLIC_PWA_ENABLED=false
# Reserved, not read by the code yet: future cache tiers shell | read | sync.
# NEXT_PUBLIC_PWA_CACHE_LEVEL=shell

# Web Push for draft turn alerts (docs/push.md). All three must be set and valid,
# otherwise push is disabled: the server sends nothing and the draft room hides
# the push control. Generate a key pair once per deployment with
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is the public key (baked into the client bundle at
# build time, so set it before building). VAPID_PRIVATE_KEY is a server secret:
# never expose it and never reuse a key pair across deployments. VAPID_SUBJECT is
# a contact the push services can reach: a mailto: address or an https: URL.
# Changing the key pair invalidates every stored subscription.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# AI Agent direct model APIs (OpenAI-compatible) — see src/lib/ai/agent/model-router.ts
# DeepSeek (T0 text candidate — T1 escalation)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
# Xiaomi (T0 text candidate — default T0)
XIAOMI_API_KEY=
XIAOMI_BASE_URL=
# MiniMax (T0-V vision)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
# Selects which registered model id leads the registry (the default T0).
# Value must be a known id (mimo-v2.6-pro, deepseek-v4-pro, minimax-m3,
# claude-haiku-4-5, claude-sonnet-4-6); an unknown id warns and keeps the
# built-in order. Leave blank to use the built-in default (mimo-v2.6-pro).
AGENT_DEFAULT_MODEL=
# Override the provider-side model NAME for a given tier (not the default pick).
AGENT_DEEPSEEK_MODEL=
AGENT_XIAOMI_MODEL=
AGENT_MINIMAX_MODEL=
# Reasoning effort passed to providers that support it: 'none' | 'low' | 'medium' | 'high'.
# Default 'none' (the OpenAI-compatible tiers do not expose reasoning detection).
AGENT_REASONING_EFFORT=none
# Per-player agent-chat messages/day (reuses the rate-limit RPC). Covers chat,
# analyze-match, and tournament-report — all funnel through `agent-chat`.
AGENT_DAILY_LIMIT=20

# Meshy text-to-3d API key (props pipeline — scripts/world-assets/props.mjs)
MESHY_API_KEY=

# Development only: log Supabase request counts (never active in production).
# Report with scripts/data/meter-report.mjs.
# SUPABASE_METER=1

# Private game assets (optional; build time only). The trainer avatar layers
# (public/avatar/) and the Pokémon GLBs (public/models/draft-room/) are not
# distributed with this repository (see NOTICE.md). Without them, `npm run dev`
# and `npm run build` generate placeholder avatar layers automatically.
# A deployment that keeps the real files in a PRIVATE GitHub repo (same paths)
# can have `prebuild` fetch them (scripts/fetch-private-assets.mjs):
#   PRIVATE_ASSETS_REPO   owner/name of that repo. Empty (the default, and the
#                         right value for forks) = skip and use placeholders.
#   PRIVATE_ASSETS_REF    branch, tag or SHA to fetch (default: main). Leave it
#                         unset on Vercel previews: a preview then fetches the
#                         private branch named like the public one, or main when
#                         the private repo has no such branch.
#   PRIVATE_ASSETS_TOKEN  fine-grained GitHub token limited to that one repo
#                         with Contents: Read-only. Server/build secret only.
# A Vercel production build (VERCEL_ENV=production) without a token fails, so
# the real assets are never replaced silently. A fork that wants to ship the
# placeholders in production sets ALLOW_PLACEHOLDER_ASSETS=1.
# PRIVATE_ASSETS_REPO=
# PRIVATE_ASSETS_REF=main
# PRIVATE_ASSETS_TOKEN=
# ALLOW_PLACEHOLDER_ASSETS=

# Format pack (build time; docs/format-packs.md). Selects the league tuning
# that `@/lib/format-pack` reads:
#   unset     use the private pack (src/format-packs/private/) when it is on
#             disk, otherwise the public example pack. Right for local dev.
#   example   always use the public example pack (src/format-packs/example/).
#   private   require the private pack; the build fails if it is missing.
# Set FORMAT_PACK=private in the Production environment only, so a Production
# build can never ship the example pack by accident. Any other value is an error.
# FORMAT_PACK=
